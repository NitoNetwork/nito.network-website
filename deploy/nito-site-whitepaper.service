[Unit]
Description=Nito Network official whitepaper synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nito-site-whitepaper
Group=nito-site-whitepaper
StateDirectory=nito-site-whitepaper
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 /opt/nito-site-runtime/current/scripts/sync-whitepaper.py --state-dir /var/lib/nito-site-whitepaper
TimeoutStartSec=90
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=96M
CPUQuota=10%
StandardOutput=null
StandardError=journal
