server {
    listen 80;
    listen [::]:80;
    server_name nito.network www.nito.network;
    access_log off;
    error_log /dev/null crit;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://nito.network$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name nito.network www.nito.network;
    access_log off;
    error_log /dev/null crit;

    root /var/www/nito.network/current;
    index index.html;
    error_page 404 /404.html;

    ssl_certificate /etc/letsencrypt/live/nito.network/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nito.network/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    charset utf-8;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self' https://api.github.com https://raw.githubusercontent.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/javascript application/json application/xml image/svg+xml text/css text/plain;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location ~ ^/assets/index-[A-Za-z0-9_-]+\.(?:css|js)$ {
        try_files $uri =404;
        expires 1y;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1h;
    }

    location ^~ /media/ {
        try_files $uri =404;
        expires 7d;
    }

    location = /data/activation.json {
        alias /var/lib/nito-site-activation/activation.json;
        default_type application/json;
        expires 60s;
        etag on;
    }

    location = /whitepaper-data/current.json {
        alias /var/lib/nito-site-whitepaper/public/current.json;
        default_type application/json;
        expires 60s;
        etag on;
    }

    location ^~ /whitepaper-data/ {
        alias /var/lib/nito-site-whitepaper/public/;
        autoindex off;
        expires 1d;
        etag on;
    }

    location = /404.html {
        internal;
    }

    location / {
        try_files $uri $uri/ =404;
        expires -1;
    }

    location ~ /\. {
        deny all;
    }
}
