{
  "name": "nito-network-website",
  "version": "1.0.0",
  "description": "Official public website for Nito Network",
  "author": "Nito Network <help@nito.network>",
  "private": true,
  "license": "MIT",
  "homepage": "https://nito.network",
  "repository": {
    "type": "git",
    "url": "https://github.com/NitoNetwork/nito.network-website.git"
  },
  "bugs": {
    "url": "https://github.com/NitoNetwork/nito.network-website/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "test": "npm run build:test && tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "refresh": "node scripts/releases.mjs"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "dompurify": "3.4.18",
    "lucide": "^0.577.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  }
}
